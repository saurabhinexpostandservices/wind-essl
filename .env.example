# SQL Server Configuration (eTimeTrackLite on Windows)
SQL_SERVER=localhost\\SQLEXPRESS
SQL_DATABASE=etimetracklitenew
SQL_USER=sa
SQL_PASSWORD=YOUR_SQL_PASSWORD
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECTION_TIMEOUT=15000
SQL_REQUEST_TIMEOUT=30000

# VPS Team Management API Configuration
# In production, must be an HTTPS URL
API_URL=https://team-api.digitalfyx.com/api/integrations/essl/attendance
API_KEY=YOUR_LONG_RANDOM_SECRET_KEY
DEVICE_ID=office-essl

# Sync Configuration
SYNC_INTERVAL=30000
BATCH_SIZE=1000
TIMEZONE=Asia/Kolkata

# Local Diagnostic & Management Web UI (Bound strictly to loopback)
HEALTH_PORT=8765
HEALTH_HOST=127.0.0.1

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=14
