# SQL Server Configuration (eTimeTrackLite on Windows)
SQL_SERVER=localhost\\SQLEXPRESS
SQL_DATABASE=etimetracklitenew
SQL_USER=sa
SQL_PASSWORD=YOUR_SQL_PASSWORD
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECTION_TIMEOUT=15000
SQL_REQUEST_TIMEOUT=30000

# VPS Team Management API Configuration
# In production, must be an HTTPS URL
API_URL=https://team-api.digitalfyx.com/api/integrations/essl/attendance
API_KEY=YOUR_LONG_RANDOM_SECRET_KEY
DEVICE_ID=office-essl

# Sync Configuration
SYNC_INTERVAL=30000
BATCH_SIZE=1000
TIMEZONE=Asia/Kolkata

# Targeted Sync Filters:
# 1. Only pull records for employees registered on Leave Management System (true/false)
SYNC_REGISTERED_ONLY=true

# 2. Only pull records after a specific date (YYYY-MM-DD or YYYY-MM-DDTHH:mm:ss)
# e.g., 2026-01-01 to ignore old historical years from dbo.GREYTIP
SYNC_START_DATE=2026-01-01

# 3. Optional manual employee code filter (comma-separated). Leave empty to use auto LMS list.
# SYNC_EMPLOYEE_CODES=101,102,105,ESS104

# Local Diagnostic & Management Web UI (Bound strictly to loopback)
HEALTH_PORT=8765
HEALTH_HOST=127.0.0.1

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=14
